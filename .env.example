# Supabase project settings → API: project URL and publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase Connect → Transaction pooler → URI, port 6543.
# Replace [YOUR-PASSWORD] with the URL-encoded database password.
DATABASE_URL=
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Back it up privately. Changing this prevents decrypting existing AI keys.
ATLAS_MASTER_KEY=
# Local now; set to your exact https://...vercel.app address when deploying.
NEXT_PUBLIC_APP_URL=http://localhost:3211
AUTO_FILE_CONFIDENCE=0.78
ATLAS_PROVIDER_TIMEOUT_MS=90000
# Optional: trusted custom provider origins, comma-separated HTTPS origins.
ATLAS_ALLOWED_PROVIDER_ORIGINS=
# Optional: Supabase database root CA PEM, with escaped newlines.
SUPABASE_DB_CA=

# google (default), email, or both. Email requires a working custom SMTP sender.
ATLAS_AUTH_METHOD=google
# Set true only after enabling the Google provider in Supabase.
ATLAS_GOOGLE_AUTH_ENABLED=false
